{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "zeta",
  "description": "Values for the zeta IRC bot Helm chart. The `zeta` section mirrors the bot's `config.toml`; see the repository `config.toml` for the authoritative documentation of every key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zeta"
  ],
  "properties": {
    "global": {
      "type": "object",
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string",
          "description": "Overrides the image tag whose default is the chart appVersion."
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean",
          "default": true,
          "description": "Specifies whether a service account should be created."
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Annotations to add to the service account."
        },
        "name": {
          "type": "string",
          "description": "The name of the service account to use. If not set and `create` is true, a name is generated using the fullname template."
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "additionalProperties": true
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0,
      "default": 30,
      "description": "Time for the bot to disconnect from the IRC server (QUIT) before the container is killed."
    },
    "livenessProbe": {
      "type": "object",
      "additionalProperties": true
    },
    "readinessProbe": {
      "type": "object",
      "additionalProperties": true
    },
    "volumes": {
      "type": "array"
    },
    "volumeMounts": {
      "type": "array"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "env": {
      "type": "array"
    },
    "envFrom": {
      "type": "array"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object",
      "additionalProperties": true
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Create a NetworkPolicy that restricts the bot's egress to DNS and the internet (private and link-local ranges excluded)."
        },
        "additionalEgress": {
          "type": "array",
          "description": "Additional egress rules appended to the policy, e.g. for an in-cluster database."
        }
      }
    },
    "zeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database",
        "irc",
        "tracing"
      ],
      "properties": {
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "description": "PostgreSQL connection string. Prefer overriding it with the ZETA_DATABASE__URL environment variable in production."
            },
            "idle_timeout": {
              "type": "string",
              "description": "The maximum idle duration for individual connections. Defaults to \"5s\"."
            },
            "max_connections": {
              "type": "integer",
              "minimum": 1,
              "description": "The maximum number of connections that the database pool should maintain. Defaults to 5."
            }
          }
        },
        "irc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nickname",
            "alt_nicks",
            "hostname",
            "channels"
          ],
          "properties": {
            "nickname": {
              "type": "string",
              "minLength": 1,
              "description": "The client's nickname."
            },
            "alt_nicks": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Alternative nicknames for the client, if the default is taken."
            },
            "hostname": {
              "type": "string",
              "minLength": 1,
              "description": "The hostname of the server to connect to."
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "The port number of the server to connect to. Defaults to 6697 when TLS is enabled, 6667 otherwise."
            },
            "username": {
              "type": "string",
              "description": "The client's username."
            },
            "realname": {
              "type": "string",
              "description": "The client's real name."
            },
            "password": {
              "type": "string",
              "minLength": 1,
              "description": "The password to connect to the server."
            },
            "nick_password": {
              "type": "string",
              "minLength": 1,
              "description": "The client's NICKSERV password."
            },
            "should_ghost": {
              "type": "boolean",
              "description": "Whether the client should use NickServ GHOST to reclaim its primary nickname if it is in use. Has no effect if `nick_password` is not set."
            },
            "encoding": {
              "type": "string",
              "description": "The encoding type used for this connection. This is typically UTF-8, but could be something else."
            },
            "admin_hostmasks": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Hostmasks of admin users, in `nick!user@hostname` form where any of the three components may contain wildcards (`*` or `?`)."
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Toggle the use of TLS."
                }
              }
            },
            "channels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The name of the channel."
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The key to the channel if it's password protected."
                  }
                }
              }
            }
          }
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout": {
              "type": "string",
              "description": "The duration before an HTTP request times out. Defaults to \"30s\"."
            },
            "user_agent": {
              "type": "string",
              "description": "The `User-Agent` header sent with HTTP requests."
            }
          }
        },
        "mirror": {
          "type": "object",
          "additionalProperties": false,
          "description": "Media mirroring, shared by the plugins that mirror media (tiktok, reddit). Mirroring is disabled when the S3 configuration is incomplete.",
          "properties": {
            "download_dir": {
              "type": "string",
              "description": "The directory that downloads are buffered in. Must be on a writable volume."
            },
            "max_filesize": {
              "type": "string",
              "description": "The maximum size of a file to download, as passed to `yt-dlp`. Defaults to \"500M\"."
            },
            "download_timeout": {
              "type": "string",
              "description": "The maximum duration of a download before it gets killed. Defaults to \"10m\"."
            },
            "max_concurrent_downloads": {
              "type": "integer",
              "minimum": 1,
              "description": "The maximum number of downloads that run concurrently. Defaults to 4."
            },
            "ytdlp_command": {
              "type": "string",
              "description": "The command used to run `yt-dlp`. Falls back to the ZETA_YTDLP_COMMAND environment variable when unset."
            },
            "s3_access_key_id": {
              "type": "string",
              "minLength": 1,
              "description": "Falls back to the S3_ACCESS_KEY_ID environment variable when unset."
            },
            "s3_secret_access_key": {
              "type": "string",
              "minLength": 1,
              "description": "Falls back to the S3_SECRET_ACCESS_KEY environment variable when unset."
            },
            "s3_bucket_name": {
              "type": "string",
              "minLength": 1,
              "description": "Falls back to the S3_BUCKET_NAME environment variable when unset."
            },
            "s3_region": {
              "type": "string",
              "description": "The S3 region. Falls back to the S3_REGION environment variable, and to \"auto\" when neither is set."
            },
            "s3_endpoint": {
              "type": "string",
              "description": "The endpoint URL for S3-compatible services. Falls back to the S3_ENDPOINT environment variable when unset."
            }
          }
        },
        "plugins": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-plugin configuration. Sections that are omitted leave the plugin enabled with its default settings.",
          "properties": {
            "chaturbate": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                }
              }
            },
            "filter": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                }
              }
            },
            "gay": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                }
              }
            },
            "health": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                }
              }
            },
            "help": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                }
              }
            },
            "howlongtobeat": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                }
              }
            },
            "ofn": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                }
              }
            },
            "pornhub": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                }
              }
            },
            "rink": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                }
              }
            },
            "string_utils": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                }
              }
            },
            "tvmaze": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                }
              }
            },
            "alert": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "retry_delay": {
                  "type": "string",
                  "description": "How long the scheduler waits before retrying after a failed tick. Defaults to \"30s\".",
                  "default": "30s"
                },
                "max_pending_per_user": {
                  "type": "integer",
                  "default": 50,
                  "description": "The maximum number of pending alerts a user may have. Defaults to 50."
                }
              }
            },
            "choices": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "or_keywords": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [
                    "eller"
                  ],
                  "description": "The keywords that separate the options. Defaults to [\"eller\"]."
                },
                "option_separator": {
                  "type": "string",
                  "default": ", ",
                  "description": "The separator between individual options. Defaults to \", \".",
                  "minLength": 1
                }
              }
            },
            "coinmarketcap": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "api_key": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The CoinMarketCap API key. Falls back to the COINMARKETCAP_API_KEY environment variable when unset."
                },
                "default_currency": {
                  "type": "string",
                  "default": "USD",
                  "description": "The fiat currency used when a command does not specify one. Defaults to \"USD\"."
                },
                "cache_ttl": {
                  "type": "string",
                  "description": "How long the cached coins and fiat currencies stay valid before being refreshed. Defaults to \"24h\".",
                  "default": "24h"
                },
                "max_name_typos": {
                  "type": "integer",
                  "default": 2,
                  "description": "The maximum number of typos allowed when fuzzy matching a coin name. Defaults to 2."
                }
              }
            },
            "dendanskeordbog": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "show_morphology": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether to show the morphology (inflection) of the entry. Defaults to true."
                },
                "show_etymology": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether to show the etymology (origin) of the entry. Defaults to true."
                },
                "show_examples": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether to show an example sentence for the definition. Defaults to true."
                }
              }
            },
            "dig": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "nameservers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "default": [
                    "1.1.1.1",
                    "1.0.0.1",
                    "2606:4700:4700::1111",
                    "2606:4700:4700::1001"
                  ],
                  "description": "Nameservers to query over UDP and TCP. Defaults to Cloudflare's public resolvers (including IPv6)."
                }
              }
            },
            "geoip": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "api_key": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The ip2location.io API key. Falls back to the GEOIP_API_KEY environment variable when unset."
                }
              }
            },
            "github": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "token": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A GitHub API token, used to raise the rate limit for requests. Falls back to the GITHUB_TOKEN environment variable when unset."
                }
              }
            },
            "imdb": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "include_adult": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether to include adult titles in search results. Defaults to true."
                },
                "user_country": {
                  "type": "string",
                  "default": "US",
                  "description": "The country the IMDb API localises results for. Defaults to \"US\"."
                },
                "user_language": {
                  "type": "string",
                  "default": "en-US",
                  "description": "The language the IMDb API localises results for. Defaults to \"en-US\"."
                }
              }
            },
            "isitopen": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "api_key": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Google Maps API key. Falls back to the GOOGLE_MAPS_API_KEY environment variable when unset."
                }
              }
            },
            "kagi": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "session_token": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Kagi session token (the kagi_session cookie value). Falls back to the KAGI_SESSION_TOKEN environment variable when unset."
                },
                "session_duration": {
                  "type": "string",
                  "description": "How long a search session stays valid before it is refreshed. Defaults to \"15m\".",
                  "default": "15m"
                },
                "language": {
                  "type": "string",
                  "default": "en-US,en;q=0.9",
                  "description": "The Accept-Language header sent with requests. Defaults to \"en-US,en;q=0.9\"."
                }
              }
            },
            "notification": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "max_pending_per_target": {
                  "type": "integer",
                  "default": 10,
                  "description": "The maximum number of pending notifications a target may have in a channel. Defaults to 10."
                }
              }
            },
            "openweathermap": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "app_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The OpenWeatherMap API key (the \"app id\"). Falls back to the OPENWEATHERMAP_APP_ID environment variable when unset."
                },
                "units": {
                  "type": "string",
                  "enum": [
                    "metric",
                    "imperial",
                    "standard"
                  ],
                  "default": "metric",
                  "description": "The unit system used for temperatures and wind speeds."
                },
                "language": {
                  "type": "string",
                  "description": "The language used for weather condition descriptions."
                },
                "default_location": {
                  "type": "string",
                  "description": "The location used when the `.w` command is invoked without arguments."
                }
              }
            },
            "reddit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "client_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Reddit application client id. Falls back to the REDDIT_CLIENT_ID environment variable when unset."
                },
                "client_secret": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Reddit application client secret. Falls back to the REDDIT_CLIENT_SECRET environment variable when unset."
                },
                "prefix": {
                  "type": "string",
                  "description": "The key prefix that mirrored videos are uploaded under. Falls back to the REDDIT_S3_PREFIX environment variable, and to \"reddit\" when neither is set."
                },
                "public_url_base": {
                  "type": "string",
                  "description": "The base URL used when linking to mirrored videos. Falls back to the REDDIT_PUBLIC_URL_BASE environment variable when unset."
                }
              }
            },
            "rust_playground": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "channel": {
                  "type": "string",
                  "enum": [
                    "stable",
                    "beta",
                    "nightly"
                  ],
                  "default": "stable",
                  "description": "The release channel used for evaluation."
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "debug",
                    "release"
                  ],
                  "default": "debug",
                  "description": "The build mode."
                },
                "edition": {
                  "type": "string",
                  "enum": [
                    "2015",
                    "2018",
                    "2021",
                    "2024"
                  ],
                  "default": "2024",
                  "description": "The Rust edition."
                },
                "max_output_length": {
                  "type": "integer",
                  "default": 250,
                  "description": "The maximum output length, in characters. Defaults to 250."
                }
              }
            },
            "spotify": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "client_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Spotify application client id. Falls back to the SPOTIFY_CLIENT_ID environment variable when unset."
                },
                "client_secret": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Spotify application client secret. Falls back to the SPOTIFY_CLIENT_SECRET environment variable when unset."
                }
              }
            },
            "thingiverse": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "api_key": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Thingiverse app token. Falls back to the THINGIVERSE_APP_TOKEN environment variable when unset."
                }
              }
            },
            "tiktok": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "title_length": {
                  "type": "integer",
                  "default": 150,
                  "description": "The maximum length of a video title before it gets truncated. Defaults to 150."
                },
                "prefix": {
                  "type": "string",
                  "description": "The key prefix that mirrored videos are uploaded under. Falls back to the TIKTOK_S3_PREFIX environment variable, and to \"tiktok\" when neither is set."
                },
                "public_url_base": {
                  "type": "string",
                  "description": "The base URL used when linking to mirrored videos. Falls back to the TIKTOK_PUBLIC_URL_BASE environment variable when unset."
                }
              }
            },
            "titles": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable the plugin."
                },
                "ignored_hosts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
