{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stalwart chart values",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "image",
    "service",
    "persistence",
    "config",
    "resources"
  ],
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mail",
        "admin"
      ],
      "properties": {
        "mail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "ports"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "annotations": {
              "type": "object"
            },
            "externalTrafficPolicy": {
              "type": "string",
              "enum": [
                "Cluster",
                "Local"
              ]
            },
            "loadBalancerIP": {
              "type": "string"
            },
            "loadBalancerClass": {
              "type": "string"
            },
            "loadBalancerSourceRanges": {
              "type": "array"
            },
            "ipFamilyPolicy": {
              "type": "string"
            },
            "ipFamilies": {
              "type": "array"
            },
            "ports": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "smtp": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "smtps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "imaps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "https": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "pop3s": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "sieve": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "submission": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "imap": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "pop3": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "http": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                }
              }
            },
            "extraPorts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "port"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 15,
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "targetPort": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ]
                  },
                  "protocol": {
                    "type": "string",
                    "enum": [
                      "TCP",
                      "UDP",
                      "SCTP"
                    ]
                  },
                  "nodePort": {
                    "type": "integer",
                    "minimum": 30000,
                    "maximum": 32767
                  },
                  "appProtocol": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "admin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "port"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "controllerNamespace": {
          "type": "string"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pathType": {
                      "type": "string",
                      "enum": [
                        "Exact",
                        "Prefix",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": {
                "type": "string"
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "accessMode": {
          "type": "string",
          "enum": [
            "ReadWriteOnce",
            "ReadWriteOncePod"
          ]
        },
        "storageClass": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "volumeName": {
          "type": "string"
        },
        "selector": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        },
        "retentionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "whenDeleted": {
              "type": "string",
              "enum": [
                "Retain",
                "Delete"
              ]
            },
            "whenScaled": {
              "type": "string",
              "enum": [
                "Retain",
                "Delete"
              ]
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "required": [
        "@type"
      ],
      "properties": {
        "@type": {
          "type": "string",
          "enum": [
            "RocksDb",
            "Sqlite",
            "FoundationDb",
            "PostgreSql",
            "MySql"
          ]
        },
        "path": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string"
        },
        "authUsername": {
          "type": "string"
        }
      }
    },
    "configSecret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Existing Secret containing config.json. Empty renders the chart ConfigMap."
        },
        "key": {
          "type": "string",
          "description": "Key in configSecret that carries config.json."
        }
      }
    },
    "recoveryAdmin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "recoveryMode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "logLevel": {
          "type": "string"
        },
        "bind": {
          "type": "string"
        }
      }
    },
    "role": {
      "type": "string"
    },
    "pushShard": {
      "type": "string"
    },
    "publicUrl": {
      "type": "string"
    },
    "httpsPort": {
      "type": "string"
    },
    "updateRolePermissions": {
      "type": "boolean"
    },
    "tokioWorkerThreads": {
      "type": "string"
    },
    "extraEnv": {
      "type": "object"
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraInitContainers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "exec",
            "httpGet"
          ]
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 1
    },
    "minReadySeconds": {
      "type": "integer",
      "minimum": 0
    },
    "updateStrategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RollingUpdate",
            "OnDelete"
          ]
        },
        "rollingUpdate": {
          "type": "object"
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "priorityClassName": {
      "type": "string"
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "managementIngress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "extraIngress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowAll": {
              "type": "boolean"
            },
            "allowSmtp": {
              "type": "boolean"
            },
            "allowHttps": {
              "type": "boolean"
            },
            "allowHttp": {
              "type": "boolean"
            },
            "allowDatabase": {
              "type": "boolean"
            },
            "databasePort": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "extraEgress": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "create": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "secretName": {
          "type": "string"
        },
        "commonName": {
          "type": "string"
        },
        "dnsNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issuerRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Issuer",
                "ClusterIssuer"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "group": {
              "type": "string"
            }
          }
        },
        "privateKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rotationPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "Never"
              ]
            }
          }
        },
        "duration": {
          "type": "string"
        },
        "renewBefore": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "reload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "schedule": {
              "type": "string"
            },
            "credentialsSecret": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "tag"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "minLength": 1
                },
                "pullPolicy": {
                  "type": "string",
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            },
            "resources": {
              "type": "object"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exporter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "additionalLabels": {
              "type": "object"
            },
            "jobLabel": {
              "type": "string"
            },
            "relabelings": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "metricRelabelings": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "additionalLabels": {
              "type": "object"
            },
            "queueBacklogThreshold": {
              "type": "integer",
              "minimum": 0
            },
            "pvcUsageThreshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "certificateExpiryDays": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "usernameKey": {
              "type": "string",
              "minLength": 1
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeLimit": {
          "type": "string"
        }
      }
    },
    "tmp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeLimit": {
          "type": "string"
        }
      }
    },
    "e2e": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "probeImage": {
          "type": "string"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
