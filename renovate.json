{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":disableRateLimiting"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update appVersion from a Renovate annotation on the preceding line",
      "managerFilePatterns": [
        "/Chart\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+packageName=(?<packageName>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?.*?\\n\\s*appVersion:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Update appVersion from an inline Renovate annotation",
      "managerFilePatterns": [
        "/Chart\\.ya?ml$/"
      ],
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+packageName=(?<packageName>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the Renovate image in the self-hosted chart's Artifact Hub annotation",
      "managerFilePatterns": [
        "/^renovate\\/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s*renovate/renovate:(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "renovate/renovate"
    },
    {
      "customType": "regex",
      "description": "Update CI tool tags and checksums in tools.txt",
      "managerFilePatterns": [
        "/^hack\\/ci\\/tools\\.txt$/"
      ],
      "matchStrings": [
        "\\[(?<tool>[a-z0-9-]+)\\]\\nrepo=(?<depName>[^\\n]+)\\nversion=(?<currentValue>[^\\n]+)\\nsha256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Do not add image digests in Helm values files",
      "matchManagers": [
        "helm-values"
      ],
      "pinDigests": false
    },
    {
      "description": "Keep the agentgateway chart and its CRDs chart on the same version and in one PR",
      "matchManagers": [
        "helmv3"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "cr.agentgateway.dev/charts/agentgateway",
        "cr.agentgateway.dev/charts/agentgateway-crds"
      ],
      "groupName": "agentgateway"
    },
    {
      "description": "Keep the Vector Helm chart and CI binary release on the same version and in one PR",
      "matchPackageNames": [
        "vector",
        "vectordotdev/vector"
      ],
      "groupName": "vector",
      "groupSlug": "vector"
    },
    {
      "description": "The self-hosted Renovate image is controlled by the chart appVersion",
      "matchManagers": [
        "helm-values"
      ],
      "matchFileNames": [
        "renovate/values.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Group every reference to Renovate itself and only update it once a week",
      "matchSourceUrls": [
        "https://github.com/renovatebot/renovate"
      ],
      "groupName": "renovate",
      "groupSlug": "renovate",
      "schedule": [
        "* 0-3 * * 1"
      ]
    },
    {
      "description": "Keep the self-hosted chart appVersion and Artifact Hub image metadata unpinned",
      "matchPackageNames": [
        "renovate/renovate"
      ],
      "pinDigests": false
    }
  ]
}
